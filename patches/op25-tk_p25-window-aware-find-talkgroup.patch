+    def can_reach(self, tgid):
+        """Is this talkgroup's current voice frequency inside our device window?
+
+        True when the range is unconfigured (freq_min/freq_max both 0), or when
+        the talkgroup has no frequency yet -- in that case the old behaviour of
+        letting tune_voice find out is correct, and tune_voice now releases the
+        claim rather than recording silence.
+        """
+        if not self.freq_min or not self.freq_max:
+            return True
+        f = self.talkgroups[tgid].get('frequency')
+        if not f:
+            return True
+        return self.freq_min <= get_frequency(f) <= self.freq_max
