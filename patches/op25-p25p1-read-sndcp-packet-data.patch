@@ -28,7 +28,25 @@ static const int max_frame_lengths[16] = {
     0,	                    // 9 - VSELP "voice PDU"
     P25_VOICE_FRAME_SIZE,	// a - ldu2
     0,	                    // b - undef
-    962,	                // c - pdu (triple data block MBT)
+    // c - pdu. Was 962 ("triple data block MBT"): header + 3 data blocks, which
+    // is all multi-block trunking ever needs. But the SAME duid carries SNDCP
+    // PACKET DATA, and a real packet does not fit: an IPv4+UDP datagram is 28
+    // bytes of header before any payload, and an LRRP position report runs to
+    // ~58, needing 5-6 data blocks. Those frames were truncated here, so the
+    // header crc16 in p25p1_fdma.cc:494 failed and process_PDU returned BEFORE
+    // any logging -- the packet data was invisible rather than reported as
+    // dropped. That is why LWIN looked like a voice-only system for so long.
+    //
+    // 1728 is not a round number, it is the hard ceiling: frame_body is a
+    // std::vector<bool> sized P25_VOICE_FRAME_SIZE (p25_framer.cc's ctor) and
+    // the three `frame_body[next_bit++]` writes below are UNCHECKED, so any
+    // larger value is a silent overflow rather than a longer frame.
+    // Empirically 1728 yields header + 7 data blocks:
+    //     bv.size() = 1680 after status-bit removal, (1680-112)/196 = 8.
+    // Raising it further means growing that buffer and bounds-checking those
+    // writes, which is a separate change and wants evidence -- the `blks`
+    // field of real headers -- that more than 7 is actually needed.
+    1728,	                // c - pdu (header + 7 data blocks; see above)
     0, 0,	                // d, e - undef
     432	                    // f - tdu
 };
@@ -227,6 +245,21 @@ uint32_t p25_framer::load_nid(const uint8_t *syms, int nsyms, const uint64_t fs)
     if (frame_size_limit == 0)
         frame_size_limit = P25_VOICE_FRAME_SIZE;
 
+    // OBSERVABILITY for packet data. A DUID 0x0c NID having been RECEIVED is a
+    // different fact from a PDU frame having been ASSEMBLED, and until now
+    // nothing distinguished them: if the body never arrives, rx_sync's sync
+    // expiry calls sync_reset() and the frame is dropped with no trace, so an
+    // 11-hour capture with real data traffic on the tuned channel produced
+    // exactly the same silence as a system carrying no data at all.
+    //
+    // This line says "we saw a packet-data frame start, and here is how many
+    // more symbols we are about to demand". Pair it with the process_PDU
+    // outcome lines in p25p1_fdma.cc: NID logged + no outcome means the body
+    // never completed, which is a sync/length problem rather than a FEC one.
+    if ((duid == 0x0c) && (d_debug >= 10))
+        fprintf(stderr, "%s p25_framer::load_nid() PDU nid seen, duid=0x0c, need %u more symbols (limit %u bits)\n",
+                logts.get(d_msgq_id), (frame_size_limit >> 1) - nsyms, frame_size_limit);
+
     return (frame_size_limit >> 1) - nsyms;
 }
 
