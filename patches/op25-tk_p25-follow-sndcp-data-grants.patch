+                                 (log_ts.get(), m_rxid, dso, ch1, self.channel_id_to_string(ch1), ch2, llid))
+            if not freq:
+                # Loud, because this is how the offset bug above hid: an
+                # unresolvable channel id silently meant "no data grants exist".
+                if self.debug >= 10:
+                    sys.stderr.write('%s [%d] tsbk(0x14) sndcp_data_ch_grant: ch1 %x does not resolve to a frequency\n' %
+                                     (log_ts.get(), m_rxid, ch1))
+            if freq and self.rx_ctl is not None:
+                self.rx_ctl.tune_data_receivers(freq, llid)
