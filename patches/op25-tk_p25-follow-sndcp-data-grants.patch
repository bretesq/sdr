+    # A data receiver stays put this long before another grant may move it.
+    # LWIN issues ~21 data grants/minute spread over 15 channels, so an
+    # unconstrained retune would hop away mid-burst and decode nothing. The
+    # receiver also needs time to acquire sync (measured ~0.17 s on this
+    # system) before any PDU can be framed at all.
+    DATA_DWELL_SEC = 3.0
+
+    def tune_data_receivers(self, freq, llid):
+        """Point every data-only receiver at a freshly granted SNDCP channel.
+
+        WHY THIS EXISTS. LWIN does NOT have a fixed data channel. Measured over
+        11 hours: 8,084 SNDCP grants (TSBK 0x14) spread across 19 DIFFERENT
+        frequencies, allocated out of the ordinary traffic-channel pool exactly
+        as voice is. A receiver pinned to one frequency sees ~4% of them.
+
+        Deliberately NOT routed through the voice pool. tune_voice is
+        talkgroup-centric (it reads self.talkgroups[tgid]['tag']) and data
+        grants have no talkgroup; more importantly, putting data grants into
+        find_talkgroup would make them compete with voice for receivers, and
+        the 800 leg carries 84% of voice traffic. This path only ever touches
+        receivers explicitly marked data_only in the channel config, so voice
+        coverage cannot regress.
+        """
+        if freq is None or int(freq) == 0:
+            return
+        now = time.time()
+        for msgq_id in sorted(self.receivers.keys()):
+            config = self.receivers[msgq_id].get('config') or {}
+            if not config.get('data_only'):
+                continue
+
+            # Respect the device window. These receivers sit on non-tunable
+            # HackRFs covering different bands, and a grant on the other leg is
+            # simply unreachable -- the same lesson as can_reach() above, which
+            # exists because cross-band claims cost 1,243 failed tunes.
+            lo, hi = int(config.get('freq_min') or 0), int(config.get('freq_max') or 0)
+            if lo and hi and not (lo <= int(freq) <= hi):
+                if self.debug >= 10:
+                    sys.stderr.write("%s [%d] data grant skipped: %f outside window %f-%f\n" %
+                                     (log_ts.get(), msgq_id, freq / 1e6, lo / 1e6, hi / 1e6))
+                continue
+
+            if now - self.data_tuned_at.get(msgq_id, 0.0) < self.DATA_DWELL_SEC:
+                if self.debug >= 10:
+                    sys.stderr.write("%s [%d] data grant skipped: dwell, %.1fs since last retune\n" %
+                                     (log_ts.get(), msgq_id, now - self.data_tuned_at.get(msgq_id, 0.0)))
+                continue
+            self.data_tuned_at[msgq_id] = now
+
+            tune_params = {'tuner':   msgq_id,
+                           'sigtype': "P25",
+                           'freq':    int(freq),
+                           'tgid':    None,
+                           'rate':    4800,          # P25 Phase 1 FDMA data
+                           'tdma':    None}
+            if self.frequency_set is None:
+                return
+            rc = self.frequency_set(tune_params)
+            if rc is False:
+                # Explicitly `is False`: only multi_rx.change_freq returns a
+                # bool, and a frequency_set returning None must not be read as
+                # failure. Same reasoning as tune_voice.
+                if self.debug >= 5:
+                    sys.stderr.write("%s [%d] data grant unreachable, freq %f, llid %d\n" %
+                                     (log_ts.get(), msgq_id, freq / 1e6, llid))
+                continue
+            if self.debug >= 5:
+                sys.stderr.write("%s [%d] data grant: tuned to %f for llid %d\n" %
+                                 (log_ts.get(), msgq_id, freq / 1e6, llid))
+
     # post_init is called once after all receivers have been created
